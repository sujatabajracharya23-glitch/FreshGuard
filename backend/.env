# Rename this file to .env and fill in your own local values.
# These match a standard XAMPP / MySQL Workbench local MySQL install.

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freshguard

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Verification codes expire after this many minutes (UC1 - alt course Line 6)
VERIFICATION_CODE_TTL_MINUTES=15
